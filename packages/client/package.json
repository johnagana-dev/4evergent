{
  "name": "@4evergent/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node init && pnpm --filter @4evergent/shared build && tsc -p tsconfig.json",
    "test": "pnpm run build && tsc -p test/tsconfig.json --noEmit && tsx --test test/*.test.ts",
    "typecheck": "pnpm --filter @4evergent/shared build && tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@4evergent/shared": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
